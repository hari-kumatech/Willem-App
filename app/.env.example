# Copy to .env.local and fill in. setup.ps1 does this for you on a fresh laptop.

# --- Database: PostgreSQL + PostgREST in Docker (docker-compose.yml) ------------
# `npm run db:start` generates the three secrets below in .env.local the first time.
POSTGREST_URL=http://127.0.0.1:54331
AUTH_JWT_SECRET=                           # server only, never share (signs logins + database tokens)
POSTGRES_PASSWORD=
AUTHENTICATOR_PASSWORD=

# --- App -------------------------------------------------------------------------
# The URL n8n (in Docker) uses to call the app back
APP_URL=http://host.docker.internal:3000
# Optional: laptop IP(s) colleagues use in dev mode, comma-separated (production mode needs nothing)
LAN_HOSTS=

# --- n8n (empty = demo mode with sample companies) ------------------------------
# Filled in by `npm run n8n:setup`
N8N_DISCOVERY_WEBHOOK_URL=
N8N_ENRICH_WEBHOOK_URL=
N8N_SEND_EMAIL_WEBHOOK_URL=
# Shared secret in both directions (openssl rand -hex 32)
N8N_SECRET=

# --- AI ---------------------------------------------------------------------------
# AI_PROVIDER=ollama  → free local model (install Ollama, then: ollama pull qwen2.5:7b)
# ANTHROPIC_API_KEY   → Claude (best quality, pay per use). Neither → rules mode (regelmodus)
AI_PROVIDER=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_NUM_CTX=16384
OLLAMA_TIMEOUT_SECONDS=600

ANTHROPIC_API_KEY=
AI_MODEL_QUALIFIER=claude-opus-5-5
AI_MODEL_CONTACTS=claude-sonnet-5-5
AI_MODEL_PREFILTER=claude-haiku-4-5-20251001
AI_MODEL_OUTREACH=claude-opus-5-5
AI_MODEL_PLANNER=claude-haiku-4-5-20251001

# --- Optional --------------------------------------------------------------------
KVK_API_KEY=
DEFAULT_TIMEZONE=Europe/Amsterdam

# The Apify token is NOT set here: it is stored only as an n8n credential (npm run n8n:setup).
