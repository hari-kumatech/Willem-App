# Safety net for the whole repo. Each app also has its own .gitignore.
# Everything ignored here is recreated on a fresh clone: npm install, .\start.ps1 (or npm run db:start)
# and npm run n8n:setup. See "Willem App/Kumatech _customers _App/mek-sales-hub/README.md".

# Dependencies and build output (npm install / npm run build)
node_modules/
.next/
out/
build/
dist/
coverage/
*.tsbuildinfo
next-env.d.ts

# Secrets: every machine generates its own (npm run db:start, npm run n8n:setup)
.env*
!.env.example
*.local
*.pem

# Local data: database backups and dumps stay on the machine that made them
backups/
*.sql.gz
*.dump

# Test output and temp files
test-results/
playwright-report/
*.tmp.*

# Logs
*.log
npm-debug.log*

# Claude Code: local settings and session files
.claude/settings.local.json
.claude/*.lock

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini
~$*
