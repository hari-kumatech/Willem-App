        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 20000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "mekOutboundAuth1",
          "name": "n8n → MEK app (Bearer)"
        }
      },
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "00000000-0000-4000-8000-000000000004",
      "name": "Budget OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "00000000-0000-4000-8000-000000000003",
              "leftValue": "={{ $json.allowed === true }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000005",
      "name": "Start actor",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://api.apify.com/v2/acts/' + $('Start').first().json.actorId + '/runs?waitForFinish=60' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($('Start').first().json.input) }}",
        "options": {
          "timeout": 90000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "mekApifyToken001",
          "name": "Apify API token"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "00000000-0000-4000-8000-000000000006",
      "name": "Track run",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Works for the start response and every poll: { data: { id, status, defaultDatasetId, usageTotalUsd } }\n        const d = $input.first().json.data || {};\n        return [{ json: { apifyRunId: d.id, status: d.status, datasetId: d.defaultDatasetId, costUsd: Number(d.usageTotalUsd || 0), polls: $runIndex } }];"
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000008",
      "name": "Finished?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1100,
        200
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "00000000-0000-4000-8000-000000000007",
              "leftValue": "={{ !['READY', 'RUNNING'].includes($json.status) || $json.polls >= ($('Start').first().json.maxPolls || 40) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000010",
      "name": "Wait 15 s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1100,
        420
      ],
      "parameters": {
        "amount": 15,
        "unit": "seconds"
      },
      "webhookId": "00000000-0000-4000-8000-000000000009"
    },
    {
      "id": "00000000-0000-4000-8000-000000000011",
      "name": "Poll run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        420
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://api.apify.com/v2/actor-runs/' + $('Track run').last().json.apifyRunId }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "mekApifyToken001",
          "name": "Apify API token"
        }
      },
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "00000000-0000-4000-8000-000000000013",
      "name": "Still running?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1320,
        200
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "00000000-0000-4000-8000-000000000012",
              "leftValue": "={{ ['READY', 'RUNNING'].includes($json.status) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000014",
      "name": "Abort run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        100
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://api.apify.com/v2/actor-runs/' + $json.apifyRunId + '/abort' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "mekApifyToken001",
          "name": "Apify API token"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "00000000-0000-4000-8000-000000000015",
      "name": "Get items",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        200
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://api.apify.com/v2/datasets/' + $('Track run').last().json.datasetId + '/items?clean=true&format=json&limit=' + ($('Start').first().json.maxItems || 1000) }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 120000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "mekApifyToken001",
          "name": "Apify API token"
        }
      },
      "onError": "continueErrorOutput",
      "alwaysOutputData": true
    },
    {
      "id": "00000000-0000-4000-8000-000000000016",
      "name": "Return result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const run = $('Track run').last().json;\n        const items = $input.all().map((i) => i.json).filter((j) => j && Object.keys(j).length > 0);\n        const ok = run.status === 'SUCCEEDED';\n        return [{ json: { status: run.status, items, costUsd: run.costUsd, apifyRunId: run.apifyRunId, error: ok ? null : `Apify run ${run.status}` } }];"
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000017",
      "name": "Return error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        520
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const j = $input.first().json || {};\n        const e = j.error;\n        const msg = String(typeof e === 'string' ? e : (e && (e.message || e.description)) || JSON.stringify(e || j)).slice(0, 500);\n        let cost = 0;\n        try {\n          cost = $('Track run').last().json.costUsd || 0;\n        } catch {}\n        return [{ json: { status: 'ERROR', items: [], costUsd: cost, error: msg } }];"
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000018",
      "name": "Return budget stop",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        420
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const j = $input.first().json || {};\n        return [{ json: { status: 'BUDGET', items: [], costUsd: 0, error: `budget: ${j.reason || 'reached'}` } }];"
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000020",
      "name": "Note 0019",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -40
      ],
      "parameters": {
        "content": "## Apify actor run (sub-workflow)\nCalled by Discovery and Enrich, once per actor.\n1. Asks the app how much budget is left (GET budgetUrl).\n2. Starts the actor asynchronously (Apify sync calls stop after 300 s).\n3. Polls every 15 s until it finishes (max `maxPolls`, then aborts).\n4. Fetches the dataset and returns `{ status, items, costUsd }` with the real cost from Apify.",
        "width": 520,
        "height": 260
      }
    }
  ],
